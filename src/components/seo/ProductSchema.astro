---
/**
 * 商品ページ用構造化データ（Product + AggregateOffer）
 * products/[...slug].astroに組み込んで使用
 */
import { SITE_CONFIG } from '../../config/site';

interface Props {
  name: string;
  description: string;
  image?: string;
  category: string;
  saleStatus: string;
  url: string;
  price?: number;
  priceTiers?: Array<{ minQuantity: number; unitPrice: number }>;
  boxPricing?: Array<{ size: string; price: number }>;
  flowerType?: string;
  datePublished?: string;
  dateModified?: string;
  purchasable?: boolean;
}

const {
  name,
  description,
  image,
  category,
  saleStatus,
  url,
  price,
  priceTiers,
  boxPricing,
  flowerType,
  datePublished,
  dateModified,
  purchasable = true,
} = Astro.props;

const { business } = SITE_CONFIG;

// saleStatus → schema.org availability マッピング
const availabilityMap: Record<string, string> = {
  available: 'https://schema.org/InStock',
  out_of_stock: 'https://schema.org/OutOfStock',
  seasonal: 'https://schema.org/PreOrder',
  preparing: 'https://schema.org/PreOrder',
  discontinued: 'https://schema.org/Discontinued',
};

const availability = availabilityMap[saleStatus] || 'https://schema.org/OutOfStock';

// Offers構築（市場出荷品=直接購入不可、または価格情報が一切無い場合はoffersキーごと省略）
let offers: Record<string, unknown> | undefined;

if (purchasable === false) {
  offers = undefined;
} else if (priceTiers && priceTiers.length > 0) {
  const prices = priceTiers.map((t) => t.unitPrice);
  offers = {
    "@type": "AggregateOffer",
    "lowPrice": Math.min(...prices),
    "highPrice": Math.max(...prices),
    "priceCurrency": "JPY",
    "availability": availability,
  };
} else if (boxPricing && boxPricing.length > 0) {
  const prices = boxPricing.map((b) => b.price);
  offers = {
    "@type": "AggregateOffer",
    "lowPrice": Math.min(...prices),
    "highPrice": Math.max(...prices),
    "priceCurrency": "JPY",
    "availability": availability,
  };
} else if (price) {
  offers = {
    "@type": "Offer",
    "price": price,
    "priceCurrency": "JPY",
    "availability": availability,
  };
} else {
  offers = undefined;
}

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": flowerType ? `${flowerType} - ${name}` : name,
  "description": description,
  ...(image && { "image": new URL(image, business.url).href }),
  "brand": {
    "@type": "Brand",
    "name": business.name,
  },
  ...(category && { "category": category }),
  ...(offers && { "offers": offers }),
  "url": new URL(url, business.url).href,
  // 鮮度シグナル（P2-I）。git初出日/最終更新日の実値がある商品のみ出力（無い場合は捏造せず省略）
  ...(datePublished && { "datePublished": datePublished }),
  ...(dateModified && { "dateModified": dateModified }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
