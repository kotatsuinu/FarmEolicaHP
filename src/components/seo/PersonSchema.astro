---
/**
 * 園主（関口卓磨）Person構造化データ（P1-G）
 * /about のプロフィールセクション（id="person-takuma"）に1回だけ描画する（正典）。
 * 他ページのArticle.authorはこの@idを参照するのみ（Person本体をここ以外で再出力しない）。
 */
import { SITE_CONFIG } from '../../config/site';

interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const isEn = lang === 'en';

const { person, sns, business } = SITE_CONFIG;

// 英語ページ用の値（既定 'ja' は site.ts の値のまま）。@id・url は英語の /en/about/ 側にする
const personEn = {
  name: 'Takuma Sekiguchi',
  alternateName: 'Sekiguchi Takuma',
  jobTitle: 'Farm owner (new farmer)',
  description: 'Former town magazine editor who started farming. Runs Farm Eolica in Namie, Fukushima, growing lisianthus, spray chrysanthemums, stock and other flowers with data-driven smart farming, developed in-house from the "Remote Farming Support System" by NARO (National Agriculture and Food Research Organization).',
  knowsAbout: ['Loss Flower', 'Flower cultivation', 'Starting a farm as a new farmer'],
  url: 'https://farmeolica.com/en/about/',
};
const p = isEn ? personEn : person;

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${p.url}#person-takuma`,
  "name": p.name,
  "alternateName": p.alternateName,
  "jobTitle": p.jobTitle,
  "description": p.description,
  "url": p.url,
  "knowsAbout": p.knowsAbout,
  "sameAs": [sns.note, sns.x],
  "worksFor": {
    "@id": `${business.url}/#organization`,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
