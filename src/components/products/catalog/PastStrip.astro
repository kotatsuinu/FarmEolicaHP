---
/**
 * 「これまでにお届けした花」。販売終了を小さめ正方形の写真の横めくり列で。
 * 0件なら何も出さない。押すと商品ページ。
 */
import { Image } from 'astro:assets';
import type { ProductEntry } from './split';

interface Props {
  items: ProductEntry[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="sec inner">
    <h2>これまでにお届けした花</h2>
    <div class="strip">
      {items.map((p) => (
        <a class="pp" href={`/products/${p.slug}`}>
          <div class="pp-img">
            {p.data.image ? (
              <Image src={p.data.image} alt={p.data.name} width={240} height={240} sizes="120px" loading="lazy" />
            ) : (
              <span class="noimg">画像準備中</span>
            )}
          </div>
          <span class="pp-nm">{p.data.name}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .inner { padding-left: 20px; padding-right: 20px; }
  .sec { padding-top: 48px; }
  h2 { font-size: 19px; font-weight: 600; color: #4A3B32; margin: 0 0 12px; line-height: 1.5; }
  .strip {
    display: grid; grid-auto-flow: column; grid-auto-columns: 112px; gap: 10px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    margin: 0 -20px; padding: 0 20px 6px; scroll-padding: 20px; scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  .pp { scroll-snap-align: start; display: grid; gap: 6px; align-content: start; }
  .pp-img { position: relative; aspect-ratio: 1 / 1; border-radius: 6px; overflow: hidden; background: #E0DDD7; }
  .pp-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .noimg { position: absolute; inset: 0; display: grid; place-items: center; font-size: 11px; color: #7D7B77; }
  .pp-nm { font-size: 12.5px; line-height: 1.5; color: #4A3B32; }
  @media (min-width: 768px) {
    .inner { padding-left: max(48px, calc(50% - 552px)); padding-right: max(48px, calc(50% - 552px)); }
    .sec { padding-top: 56px; }
    h2 { font-size: 21px; }
    .strip { margin: 0; padding: 0 0 6px; grid-auto-columns: 128px; }
  }
</style>
