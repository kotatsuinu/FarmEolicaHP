---
/**
 * 開け閉めの1行（<details>）。値段の行だけ open を付ける。
 */
interface Props {
  title: string;
  open?: boolean;
}
const { title, open = false } = Astro.props;
---

<details class="ir" open={open}>
  <summary>
    <span>{title}</span>
    <i aria-hidden="true"></i>
  </summary>
  <div class="ir-body"><slot /></div>
</details>

<style>
  .ir { border-top: 1px solid #E0DDD7; }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 15px 2px; cursor: pointer; list-style: none;
    font-size: 16px; font-weight: 600; color: #33291F; line-height: 1.5;
  }
  summary::-webkit-details-marker { display: none; }
  summary i {
    flex: none; width: 8px; height: 8px; margin-right: 4px;
    border-right: 1.5px solid #B87333; border-bottom: 1.5px solid #B87333;
    transform: rotate(45deg) translateY(-2px); transition: transform .2s;
  }
  .ir[open] summary i { transform: rotate(-135deg) translateY(-2px); }
  .ir-body { padding: 0 2px 20px; font-size: 14.5px; line-height: 1.85; color: #4A3B32; }
  .ir-body :global(p) { margin: 0 0 .7em; }
  .ir-body :global(h4) { font-size: 14px; font-weight: 600; color: #33291F; margin: 1.1em 0 .4em; line-height: 1.6; }
  .ir-body :global(h4:first-child) { margin-top: 0; }
  .ir-body :global(ul) { margin: 0 0 .7em; padding-left: 1.2em; list-style: disc; }
  .ir-body :global(ol) { margin: 0 0 .7em; padding-left: 1.4em; list-style: decimal; }
  .ir-body :global(li) { margin: 0 0 .25em; }
  .ir-body :global(small), .ir-body :global(.note) { font-size: 12.5px; color: #7D7B77; line-height: 1.7; }
  .ir-body :global(.note) { display: block; margin: 0 0 .5em; }
  .ir-body :global(.mono) { font-family: theme('fontFamily.mono'); }
  .ir-body :global(a) { color: #B87333; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) {
    summary { font-size: 17px; }
    .ir-body { font-size: 15px; }
  }
</style>
