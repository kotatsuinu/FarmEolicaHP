---
/**
 * お問い合わせ帯（緑）。公式LINE を主ボタンに、Instagram・フォーム。
 */
import { SITE_CONFIG } from '../../../config/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'お問い合わせ・ご注文',
  text = '花の種類や届く日のご相談も、お気軽にどうぞ。',
} = Astro.props;
---

<section class="contact">
  <div class="contact-in">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cbtns">
      <a class="cbtn main" href={SITE_CONFIG.sns.line} target="_blank" rel="noopener">公式LINEで問い合わせる</a>
      <a class="cbtn" href={SITE_CONFIG.sns.instagram} target="_blank" rel="noopener">Instagram</a>
      <a class="cbtn" href="/contact">お問い合わせフォーム</a>
    </div>
  </div>
</section>

<style>
  .contact { background: #005243; color: #fff; padding: 36px 20px; }
  .contact-in { display: grid; gap: 12px; }
  .contact h2 { font-size: 20px; font-weight: 600; margin: 0; line-height: 1.5; }
  .contact p { font-size: 13px; opacity: .88; margin: 0; }
  .cbtns { display: grid; gap: 8px; margin-top: 4px; }
  .cbtn { font-size: 14px; padding: 12px 14px; border-radius: 4px; border: 1px solid rgba(255,255,255,.6); text-align: center; color: #fff !important; }
  .cbtn.main { background: #F2F2F0; color: #005243 !important; border-color: #F2F2F0; font-weight: 700; }

  @media (min-width: 768px) {
    .contact { padding: 48px max(48px, calc(50% - 552px)); }
    .contact-in { grid-template-columns: 1fr auto; align-items: center; }
    .cbtns { grid-auto-flow: column; margin: 0; }
    .cbtn { padding: 12px 22px; }
  }
</style>
