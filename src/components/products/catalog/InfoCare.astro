---
/**
 * 届いたあとの扱い（InfoRow の中に置く）。内容は FlowerCareGuide と同じ。
 * lang='en' のときは英語（英語ページ用）。既定 'ja' の出力は従来と同一。
 */
interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const t = {
  ja: {
    h1: '基本の水揚げ方法',
    a1: '茎を斜めにカット', a1d: '水の吸い上げが良くなります',
    a2: '深水に生ける', a2d: '最初は深めの水で水揚げ',
    a3: '涼しい場所', a3d: '直射日光・暖房を避けて',
    h2: '日々のお手入れ',
    b1: '水替え', b1d: '2〜3日に一度、茎の切り戻しも',
    b2: '葉の除去', b2d: '水に浸かる部分の葉は取り除く',
    b3: '室温管理', b3d: '涼しい環境で1〜2週間お楽しみいただけます',
    note: '※花の品種や状態により、日持ちは異なります',
  },
  en: {
    h1: 'Basic conditioning steps',
    a1: 'Cut the stems at an angle', a1d: 'helps the flowers take up water',
    a2: 'Place in deep water', a2d: 'start with deep water to rehydrate',
    a3: 'Keep in a cool place', a3d: 'away from direct sunlight and heating',
    h2: 'Daily care',
    b1: 'Change the water', b1d: 'every 2 to 3 days, and re-cut the stems',
    b2: 'Remove leaves', b2d: 'strip any leaves that would sit below the water line',
    b3: 'Room temperature', b3d: 'in a cool room, the flowers last 1 to 2 weeks',
    note: 'Note: Vase life varies by flower variety and condition.',
  },
}[lang];
---

<h4>{t.h1}</h4>
<ol>
  <li><b>{t.a1}</b> - {t.a1d}</li>
  <li><b>{t.a2}</b> - {t.a2d}</li>
  <li><b>{t.a3}</b> - {t.a3d}</li>
</ol>
<h4>{t.h2}</h4>
<ul>
  <li><b>{t.b1}</b>{lang === 'en' ? ': ' : '：'}{t.b1d}</li>
  <li><b>{t.b2}</b>{lang === 'en' ? ': ' : '：'}{t.b2d}</li>
  <li><b>{t.b3}</b>{lang === 'en' ? ': ' : '：'}{t.b3d}</li>
</ul>
<p class="note">{t.note}</p>
