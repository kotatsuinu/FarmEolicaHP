---
import { englishTargetOf, japaneseTargetOf } from '../config/i18n-pairs';

interface Props {
  lang: 'ja' | 'en';
  variant: 'desktop' | 'mobile' | 'works-desktop' | 'works-mobile';
  href?: string; // 行き先の上書き
}

const { lang, variant, href } = Astro.props;
const pathname = Astro.url.pathname;
const target = href ?? (lang === 'ja' ? englishTargetOf(pathname) : japaneseTargetOf(pathname));
const linkClass = 'hover:text-old-copper transition-colors duration-300';
const isMobile = variant === 'mobile' || variant === 'works-mobile';
const wrapClass = isMobile
  ? 'flex items-center gap-3 text-sm tracking-widest'
  : 'flex items-center gap-2 text-xs tracking-widest whitespace-nowrap';
const isLi = variant === 'desktop' || variant === 'mobile';
---
{isLi ? (
  <li data-lang-switch={variant} class={wrapClass}>
    {lang === 'ja' ? <span aria-current="true">日本語</span> : <a href={target} hreflang="ja" lang="ja" class={linkClass}>日本語</a>}
    <span aria-hidden="true" class="opacity-60">/</span>
    {lang === 'ja' ? <a href={target} hreflang="en" lang="en" class={linkClass}>English</a> : <span aria-current="true">English</span>}
  </li>
) : (
  <span data-lang-switch={variant} class={wrapClass}>
    {lang === 'ja' ? <span aria-current="true">日本語</span> : <a href={target} hreflang="ja" lang="ja" class={linkClass}>日本語</a>}
    <span aria-hidden="true" class="opacity-60">/</span>
    {lang === 'ja' ? <a href={target} hreflang="en" lang="en" class={linkClass}>English</a> : <span aria-current="true">English</span>}
  </span>
)}
