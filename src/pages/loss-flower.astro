---
/**
 * ロスフラワー ピラーページ — root直下 /loss-flower
 * SEO/AEO施策 P1-E: ロスフラワー通販・花材利用に関する一次情報のリファレンスページ。
 * 商品カードは置かず、購入導線は /products/loss-flower へのCTAリンクで送る。
 * schema: BreadcrumbSchema（BreadcrumbList）+ FaqSchema（FAQPage）のみ。Article/Productは付けない（P1-E スペック準拠）。
 */
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import FaqSchema from '../components/seo/FaqSchema.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import NoteLinkCard from '../components/NoteLinkCard.astro';
import PageShell from '../components/products/catalog/PageShell.astro';
import InfoRows from '../components/products/catalog/InfoRows.astro';
import InfoRow from '../components/products/catalog/InfoRow.astro';
import ContactBand from '../components/products/catalog/ContactBand.astro';
import LossHero from '../components/loss-flower/LossHero.astro';
import LossSection from '../components/loss-flower/LossSection.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/loss-flower/hero.jpg';
import rulerImage from '../assets/images/loss-flower/ruler.jpg';
import { SITE_CONFIG } from '../config/site';
import lossFlowerHeroImage from '../assets/images/products/loss-flower-hero.jpg';

const title = 'ロスフラワー通販｜農家直送の花材をまとめ買い | Farm Eolica (ファームエオリカ)';
const description = '農家直送のロスフラワー（規格外・余剰の切り花）を通販でお届け。ドライフラワー・レジン・撮影小物の花材に、新鮮なまま5本からまとめ買い。福島県浪江町の花農園から直送、法人の定期仕入れも相談可。';

// ArticleSchema用: H1（headline）・冒頭要約（description）は本文と同一文言（捏造ゼロ）。
// datePublished は git 初出日（`git log --diff-filter=A --format=%as -- src/pages/loss-flower.astro`）の実値。
const pageUrl = `${SITE_CONFIG.business.url}/loss-flower/`;
const ogImageUrl = new URL(lossFlowerHeroImage.src, SITE_CONFIG.business.url).href;
const articleHeadline = 'ロスフラワーとは｜農家直送の花材を通販でまとめ買い';
const articleDescription = 'Farm Eolica（福島県浪江町の花農園）が、仕立てや摘心の過程で生まれるロスフラワー（規格外・余剰の切り花）を農家直送でお届けしています。ドライフラワーやレジン、撮影小物などの花材として、新鮮なまま・まとまった本数でご購入いただけます。花の栽培から発送まで生産者本人が手がける一次情報として、このページにまとめました。';
const articleDatePublished = '2026-07-23'; // git初出日
const articleDateModified = '2026-07-23';

// root直下なので2階層（ホーム > ロスフラワーとは）。Breadcrumb(視覚) と BreadcrumbSchema(JSON-LD) で共有。
const breadcrumbItems = [
  { name: 'ホーム', url: '/' },
  { name: 'ロスフラワーとは', url: '/loss-flower' },
];

type FaqItem = {
  q: string;
  a: string; // 表示用（\n\n で段落を区切る。white-space: pre-wrap で改行保持）
};

const faqItems: FaqItem[] = [
  {
    q: 'ロスフラワーとは何ですか？',
    a: '仕立て作業や摘心の過程で生まれる、規格外・余剰の切り花です。花首が10〜20cmほど付いたものから、茎がほとんど無いものまで、状態には幅があります。\n\n福島県浪江町の花農園（Farm Eolica）で、生産者本人が栽培から発送まで手がけてお届けしています。',
  },
  {
    q: '花材としてどんな用途に使えますか？',
    a: 'ドライフラワー、レジン封入、撮影小物などの花材としてご利用いただけます。\n\n切り花として花瓶で楽しむのとは違う用途で、それぞれの花が持つ美しさを活かしていただけます。',
  },
  {
    q: '何本から注文できますか？（最低ロット）',
    a: '1本からでもお届け可能です。ただし送料などの輸送コストを考えると、5本以上、まとめてなら10本以上でご購入いただくほうがお得です。\n\n目安は5本以上ですが、本数はご希望に応じて柔軟に対応します。まずはお気軽にご相談ください。',
  },
  {
    q: '届いた花はどのくらい日持ちしますか？',
    a: '品目や季節によって変わりますが、輸送に問題がなければ通常10日以上日持ちするのが基本です。\n\nお客様からは「届いてから2週間以上経っても元気で、きれいに咲いている」というお声もいただいています。\n\nただし花持ちは品種・時期・輸送状況などによって変動し、生花の特性上どうしても差が出る点はあらかじめご了承ください。',
  },
  {
    q: '法人・店舗として定期的に仕入れられますか？',
    a: 'はい、承っております。花材としての継続利用や定期便など、数量・頻度・品目に応じて個別に対応いたします。\n\nまずはお気軽にご相談ください。',
  },
  {
    q: '送料や支払い方法は？',
    a: '発送は佐川急便で、送料は地域により910円〜となります。\n\nお支払いはPayPay・銀行振込・請求書払いに対応しており、初回のお取引は原則ご入金確認後の発送となります。',
  },
];

// JSON-LD 用: 表示用の \n\n 改行を空白に正規化してから渡す（/faq と同じ方式）
const schemaFaqItems = faqItems.map((item) => ({
  q: item.q,
  a: item.a.replace(/\n{2,}/g, ' ').replace(/\s+/g, ' ').trim(),
}));
---

<Layout title={title} description={description} image={lossFlowerHeroImage.src} ogType="article">

<BreadcrumbSchema items={breadcrumbItems} />
<FaqSchema items={schemaFaqItems} />
<ArticleSchema
  headline={articleHeadline}
  description={articleDescription}
  url={pageUrl}
  datePublished={articleDatePublished}
  dateModified={articleDateModified}
  image={ogImageUrl}
  publisherId={`${SITE_CONFIG.business.url}/#organization`}
/>

<PageShell>
  <LossHero
    image={heroImage}
    alt="畑で手に持った薄紫のトルコギキョウ"
    crumb={breadcrumbItems}
  />

  <section class="lead">
    <p>
      Farm Eolica（福島県浪江町の花農園）が、仕立てや摘心の過程で生まれるロスフラワー（規格外・余剰の切り花）を農家直送でお届けしています。ドライフラワーやレジン、撮影小物などの花材として、新鮮なまま・まとまった本数でご購入いただけます。花の栽培から発送まで生産者本人が手がける一次情報として、このページにまとめました。
    </p>
  </section>

  <LossSection heading="ロスフラワーとは">
    <p>
      ロスフラワーとは、切り花の仕立て作業や摘心の過程で発生する、規格外・余剰の切り花のことです。切り花として市場に出荷するには適さないものの、花そのものは美しく、その部分を花材としてお届けしています。
    </p>
    <p>
      状態には幅があり、花首が10〜20cmほど付いたものから、茎がほとんど無いものまでさまざまです。福島県浪江町の花農園（Farm Eolica）で、生産者本人が栽培から発送まで手がけている一次情報の花材です。
    </p>
    <div class="photo">
      <Image src={rulerImage} alt="ものさしの横に並べた、茎の長さが違うトルコギキョウのロスフラワー" widths={[640, 960, 1280]} sizes="(min-width: 768px) 700px, 100vw" loading="lazy" />
    </div>
  </LossSection>

  <LossSection heading="規格外の切り花との違い">
    <div class="cmp-wrap">
      <table>
        <thead>
          <tr><th></th><th>ロスフラワー</th><th>規格外切り花</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">形態</th><td>花頭中心（短い茎付き〜茎なし）</td><td>茎付き（切り花）</td></tr>
          <tr><th scope="row">用途</th><td>クラフト・ドライフラワー</td><td>花瓶に生けて鑑賞</td></tr>
          <tr><th scope="row">価格</th><td>一律価格</td><td>花の種類により異なる</td></tr>
        </tbody>
      </table>
    </div>
  </LossSection>

  <LossSection heading="農家直送が花材に向くわけ">
    <p>
      Farm Eolicaのロスフラワーは、福島県浪江町の花農園から農家直送でお届けします。栽培から発送まで生産者本人が手がけているため、新鮮な状態のまま、まとまった本数でご用意しやすいのが特徴です。
    </p>
    <p>
      ドライフラワーやレジンなど、まとまった量が必要な花材用途にも、農家直送だからこそ対応しやすい花材です。
    </p>
  </LossSection>

  <LossSection heading="花材としての使い方">
    <ul class="uses">
      <li><b>ドライフラワー</b>：素材として最適</li>
      <li><b>レジン封入</b>：アクセサリー作りに</li>
      <li><b>撮影小物</b>：フォトプロップスに</li>
    </ul>
  </LossSection>

  <section class="note-card">
    <NoteLinkCard
      url={SITE_CONFIG.noteArticles.lossFlowerStory}
      title="農家が語る、ロスフラワーのこと"
      description="なぜロスフラワーが生まれるのか、農家の想いを綴ったnote記事です。"
      variant="featured"
    />
  </section>

  <InfoRows heading="購入について">
    <InfoRow title="価格">
      <p>箱サイズごとの詰め合わせで、小箱1,300円〜。詳しい価格・サイズ一覧は商品ページでご確認いただけます。</p>
    </InfoRow>
    <InfoRow title="最低ロット">
      <p>1本からでもお届け可能です。送料などを考えると5本以上、まとめてなら10本以上でご購入いただくほうがお得です。目安は5本以上ですが、ご希望に応じて柔軟に対応します。</p>
    </InfoRow>
    <InfoRow title="送料">
      <p>佐川急便での発送、送料は地域により910円〜です。</p>
    </InfoRow>
    <InfoRow title="支払い方法">
      <p>PayPay・銀行振込・請求書払いに対応しています。初回のお取引は原則ご入金確認後の発送となります。</p>
    </InfoRow>
  </InfoRows>
  <p class="text-link"><a href="/products/loss-flower">今お届けできる花を見る（商品ページ）→</a></p>

  <InfoRows heading="よくある質問">
    {faqItems.map((item) => (
      <InfoRow title={item.q}>
        <p class="faq-a">{item.a}</p>
      </InfoRow>
    ))}
  </InfoRows>
  <p class="text-link"><a href="/faq">ほかの質問は「よくある質問」へ →</a></p>

  <div class="gap-band"></div>
  <ContactBand />
</PageShell>

<style>
  .lead { padding: 28px 20px 0; font-size: 15px; line-height: 1.9; color: #4A3B32; }
  .lead p { margin: 0; }
  .note-card { padding: 48px 20px 0; }
  .text-link { padding: 16px 20px 0; margin: 0; font-size: 14px; }
  .text-link a { color: #B87333; text-decoration: underline; text-underline-offset: 3px; }
  .gap-band { height: 56px; }
  /* FAQ本文は 

 を含む表示用テキストのため改行を保持する（schema側は正規化済みの別配列を渡している） */
  .faq-a { white-space: pre-wrap; }
  @media (min-width: 768px) {
    .lead { padding: 36px max(48px, calc(50% - 552px)) 0; font-size: 16px; }
    .lead p { max-width: 760px; }
    .note-card { padding: 56px max(48px, calc(50% - 552px)) 0; }
    .note-card > :global(a) { max-width: 760px; }
    .text-link { padding: 16px max(48px, calc(50% - 552px)) 0; }
  }
</style>

</Layout>
