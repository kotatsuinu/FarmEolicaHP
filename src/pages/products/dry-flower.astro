---
/**
 * ドライフラワーページ（スマホ第一・商品一覧と同じ作り）
 * 規格外花→ドライ加工のストーリー。価格は品目・形態により異なる（各商品ページ参照）
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import dryFlowerHeroImage from '../../assets/images/products/dry-flower-hero.jpg';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import LaterList from '../../components/products/catalog/LaterList.astro';
import PastStrip from '../../components/products/catalog/PastStrip.astro';
import InfoRows from '../../components/products/catalog/InfoRows.astro';
import InfoRow from '../../components/products/catalog/InfoRow.astro';
import InfoNotice from '../../components/products/catalog/InfoNotice.astro';
import InfoBuy from '../../components/products/catalog/InfoBuy.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
import { byCategory, splitByStatus } from '../../components/products/catalog/split';

// ドライフラワーの商品を取得
const dryFlowerProducts = byCategory(await getCollection('products'), 'dried_flower');

// ジャンル別に分類（tagsで判定）。それぞれ棚／あとで／これまでに振り分ける
const headProducts = dryFlowerProducts.filter(p => p.data.tags?.includes('ヘッド'));
const longStemProducts = dryFlowerProducts.filter(p => p.data.tags?.includes('ロングステム'));
const head = splitByStatus(headProducts);
const longStem = splitByStatus(longStemProducts);
const later = [...head.later, ...longStem.later];
const past = [...head.past, ...longStem.past];

// ご注意の情報
const noticeItems = [
  {
    title: '商品特性',
    items: [
      '自然素材のため、色味・形状・大きさに個体差があります',
      '農場での収穫量・乾燥状態により、在庫に限りがあります',
      'ドライ加工品のため、デリケートな取り扱いをお願いします',
    ]
  },
  {
    title: '保管方法',
    text: '直射日光・高湿度を避け、風通しの良い場所で保管してください。湿気が多い場所ではカビの原因になりますのでご注意ください。'
  },
  {
    title: '梱包方法',
    text: 'ハードケースに入れ、緩衝材で花を保護した上でクリックポスト用ダンボールに梱包してお届けします。到着後はすみやかに取り出し、風通しの良い場所に保管してください。'
  },
  {
    title: 'クリックポスト配送について',
    items: [
      '厚さ3cmまでのハードケースに梱包し、郵便ポストへ投函します',
      'お受け取り時のご在宅は不要です（対面受取なし）',
      '日時指定はできません（クリックポスト仕様のため）',
      '追跡番号を発送完了時にお知らせします',
      'ロングステム商品は対象外となります（宅配便80サイズで別途お届け）',
    ]
  }
];
---

<Layout
  title="ドライフラワー | Farm Eolica (ファームエオリカ)"
  description="咲き終わりじゃない、ここからが美しい。Farm Eolicaのドライフラワー。自農場で育てた花を丁寧にドライ加工。クラフト素材としてお届けします。"
  image={dryFlowerHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
    { name: 'ドライフラワー', url: '/products/dry-flower' },
  ]} />

  <PageShell>
    <PageHero
      image={dryFlowerHeroImage}
      alt="Farm Eolica のドライフラワー"
      title="ドライフラワー"
      lead="咲き終わりじゃない、ここからが美しい。"
      crumb={[
        { name: 'ホーム', url: '/' },
        { name: '商品', url: '/products' },
        { name: 'ドライフラワー' },
      ]}
    />

    <PageIntro>
      <p>花農家には、出荷できない花があります。市場の規格に満たなかった花を、風通しの良い暗所で数週間かけてじっくり自然乾燥。生花とは違う、静かな美しさが引き出されます。</p>
      <p>クラフト素材に、インテリアに、スワッグに。農場から直接お届けします。</p>
    </PageIntro>

    <ProductShelf
      airy
      items={head.shelf}
      heading="ヘッド（花頭のみ）"
      showPrice={false}
      description="花頭だけを乾燥させた詰め合わせ。レジン封入・ハーバリウム・ポプリなどクラフト素材に。¥700〜（送料別）"
      emptyText="いまはヘッド商品の受付を休んでいます。次に咲く花は出荷予報でご覧いただけます。"
    />
    <ProductShelf
      items={longStem.shelf}
      heading="ロングステム（茎付き）"
      showPrice={false}
      description="40〜50cm規格の茎付き。花瓶に挿してインテリアに、スワッグやリースにも。¥88/本〜（送料別）"
      emptyText="ロングステム商品は現在準備中です。入荷のお知らせをご希望の方は、お問い合わせフォームよりご連絡ください。"
      emptyHref="/contact?product=ロングステムドライフラワー&type=other"
      emptyCta="入荷お知らせご希望 →"
    />
    <LaterList items={later} noun="ドライフラワー" showPrice={false} />
    <PastStrip items={past} />

    <InfoRows>
      <InfoRow title="値段と配送" open>
        <h4>価格について</h4>
        <p>商品価格（花代＋梱包料込）に送料が別途加算されます。品目・サイズ・色の詳細は各商品ページをご覧ください。</p>
        <h4>ヘッド商品の配送</h4>
        <p><b>クリックポスト</b>にて、全国一律<span class="mono">¥185</span>でお届けします。</p>
        <ul>
          <li>厚さ3cmまでのハードケースで発送</li>
          <li>お受け取り時のご在宅不要（郵便ポストへ投函）</li>
          <li>追跡番号付き、緩衝材で花を保護</li>
          <li><b>到着日時のご指定はできません</b></li>
        </ul>
        <h4>ロングステム商品の配送</h4>
        <p><b>宅配便80サイズ</b>でお届けします。送料は地域別運賃、日時指定可能。</p>
        <ul>
          <li>規格外切花の出荷規格に準じ、80サイズ箱で発送するため茎長30cmで切り揃え</li>
          <li>茎付きで厚みがあるためクリックポスト対象外</li>
          <li>緩衝材で花と茎を保護してダンボールに梱包</li>
          <li>到着後はすみやかに取り出し風通しの良い場所へ</li>
        </ul>
        <h4>大容量のご相談</h4>
        <p>業務用・イベント用などの大容量注文は別途お見積もりいたします。<a href="/contact?product=ドライフラワー&type=estimate">大容量・業務用のご相談 →</a></p>
      </InfoRow>
      <InfoRow title="活用アイデア">
        <ul>
          <li><b>クラフト素材</b>（ヘッド）：レジン・アクセサリー・ハーバリウムに</li>
          <li><b>インテリア</b>（ロングステム）：花瓶に挿してナチュラルな空間づくりに</li>
          <li><b>スワッグ・リース</b>（ヘッド・ロングステム）：壁飾りや贈り物の素材として</li>
        </ul>
      </InfoRow>
      <InfoRow title="ご注意"><InfoNotice items={noticeItems} /></InfoRow>
      <InfoRow title="お支払い・ご購入の流れ"><InfoBuy /></InfoRow>
    </InfoRows>

    <OtherCategories current="dry-flower" />
    <ContactBand />
  </PageShell>
</Layout>
