---
/**
 * ロスフラワーページ（スマホ第一・商品一覧と同じ作り）
 * 価格は花の種類に関わらず一律（正本は src/data/lossFlowerPricing.json）
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import lossFlowerHeroImage from '../../assets/images/products/loss-flower-hero.jpg';
import { SITE_CONFIG } from '../../config/site';
import NoteLinkCard from '../../components/NoteLinkCard.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import LaterList from '../../components/products/catalog/LaterList.astro';
import PastStrip from '../../components/products/catalog/PastStrip.astro';
import InfoRows from '../../components/products/catalog/InfoRows.astro';
import InfoRow from '../../components/products/catalog/InfoRow.astro';
import InfoPriceTable from '../../components/products/catalog/InfoPriceTable.astro';
import InfoShipping from '../../components/products/catalog/InfoShipping.astro';
import InfoCompare from '../../components/products/catalog/InfoCompare.astro';
import InfoNotice from '../../components/products/catalog/InfoNotice.astro';
import InfoBuy from '../../components/products/catalog/InfoBuy.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
import { byCategory, splitByStatus } from '../../components/products/catalog/split';
import lossFlowerPricing from '../../data/lossFlowerPricing.json';

// ロスフラワーの商品を取得し、棚／あとで／これまでに振り分ける
const lossFlowerProducts = byCategory(await getCollection('products'), 'loss_flower');
const { shelf, later, past } = splitByStatus(lossFlowerProducts);

// 価格一覧（カテゴリ共通・正本は src/data/lossFlowerPricing.json）
// ここに値を直接書かないこと。openclaw 側の返信下書き生成が同じ JSON を読むため、
// ページに直書きすると二重管理になる。
const priceList = lossFlowerPricing.priceTable;

// ご注意の情報
const noticeItems = [
  {
    title: '商品特性',
    items: [
      '規格外品のため、数量・品質保証はできません',
      '発生量に限りがあり、ご注文をお受けできない場合があります',
      '曲がり・色ムラ・サイズ不揃い等を含みます',
    ]
  },
  {
    title: '事前予約のオススメ',
    text: 'ロスフラワーは出したくて出しているものではありません。いつ発生するか、ご用意できるかお約束できないものになります。必要な時期や用途が事前にわかるようであれば、早めにご要望を含めてご連絡いただければ、可能な限り選別してご用意いたします。'
  },
  {
    title: '梱包方法',
    text: '濡れたキッチンペーパー・不織布で包み、通気性のあるスリーブに入れてお届けします。'
  }
];

const compareRows: [string, string, string][] = [
  ['形態', '花頭のみ', '茎付き（切り花）'],
  ['用途', 'クラフト・ドライフラワー', '花瓶に生けて鑑賞'],
  ['価格', '一律価格', '花の種類により異なる'],
];
---

<Layout
  title="ロスフラワー | Farm Eolica (ファームエオリカ)"
  description="廃棄される花に新しい命を。Farm Eolicaのロスフラワーをクラフト・ドライフラワー用にお届けします。"
  image={lossFlowerHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品・研究成果', url: '/products' },
    { name: 'ロスフラワー', url: '/products/loss-flower' },
  ]} />

  <PageShell>
    <PageHero
      image={lossFlowerHeroImage}
      alt="ロスフラワー"
      title="ロスフラワー"
      lead="廃棄される花に、新しい命を。"
      crumb={[
        { name: 'ホーム', url: '/' },
        { name: '商品・研究成果', url: '/products' },
        { name: 'ロスフラワー' },
      ]}
    />

    <PageIntro>
      <p>福島県浜通り、浪江町の小さな花農家です。仕立てや摘心の作業で生まれる規格外・余剰の切り花「ロスフラワー」を、クラフト作家さんやハンドメイドを楽しむ方へ、農家直送でお届けしています。</p>
      <p><a href="/loss-flower">ロスフラワーとは（詳しい解説・花材としての使い方・よくある質問）→</a></p>
    </PageIntro>

    <ProductShelf
      airy
      items={shelf}
      heading="いまお届けできる花"
      showPrice={false}
      emptyText="いまはロスフラワーの受付を休んでいます。次に咲く花は出荷予報でご覧いただけます。"
    />
    <LaterList items={later} noun="ロスフラワー" showPrice={false} />
    <PastStrip items={past} />

    <InfoRows>
      <InfoRow title="値段" open>
        <p>どの花でも同一価格です（送料別）。</p>
        <InfoPriceTable prices={priceList} note={lossFlowerPricing.displayNote} />
      </InfoRow>
      <InfoRow title="送料"><InfoShipping /></InfoRow>
      <InfoRow title="使い道">
        <ul>
          <li><b>ドライフラワー</b>：素材として最適です。</li>
          <li><b>レジン封入</b>：アクセサリー作りに。</li>
          <li><b>撮影小物</b>：フォトプロップスに。</li>
        </ul>
        <p>切り花とは違う用途で、それぞれの花が持つ本来の美しさを活かしていただけたらと願っています。</p>
        <p><a href="/loss-flower">花材としての使い方を詳しく見る →</a></p>
      </InfoRow>
      <InfoRow title="規格外切り花との違い">
        <InfoCompare
          cols={['ロスフラワー', '規格外切り花']}
          rows={compareRows}
          linkHref="/products/imperfect"
          linkText="規格外切り花はこちら →"
        />
      </InfoRow>
      <InfoRow title="ご注意"><InfoNotice items={noticeItems} /></InfoRow>
      <InfoRow title="お支払い・ご購入の流れ"><InfoBuy /></InfoRow>
    </InfoRows>

    <section class="note-card">
      <NoteLinkCard
        url={SITE_CONFIG.noteArticles.lossFlowerStory}
        title="農家が語る、ロスフラワーのこと"
        description="なぜロスフラワーが生まれるのか、農家の想いを綴ったnote記事です。"
        variant="featured"
      />
    </section>

    <OtherCategories current="loss-flower" />
    <ContactBand />
  </PageShell>
</Layout>

<style>
  .note-card { padding: 28px 20px 0; }
  @media (min-width: 768px) {
    .note-card { padding: 36px max(48px, calc(50% - 552px)) 0; }
    .note-card > :global(a) { max-width: 760px; }
  }
</style>
