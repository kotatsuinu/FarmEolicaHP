---
/**
 * 研究成果ページ
 * 自作アプリのショーケース + note記事連携
 * 外側（題の写真・紹介・見出し・お問い合わせ帯）は商品一覧と同じ作り。
 * アプリの紹介・技術的アプローチ・関連記事の中身は従来のまま。
 */
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config/site';
import { researchApps } from '../../config/research-apps';
import technologyImage from '../../assets/images/about/technology.jpg';
import NoteLinkCard from '../../components/NoteLinkCard.astro';
import AppShowcaseCard from '../../components/research/AppShowcaseCard.astro';
import DemoModal from '../../components/research/DemoModal';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
---

<Layout
  title="研究成果 | Farm Eolica (ファームエオリカ)"
  description="Farm Eolicaの研究成果。IoT栽培管理システム、混植ボードなど、農業DXの自作アプリと技術的な取り組みをご紹介します。"
  image="/images/top/hero.jpg"
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品・研究成果', url: '/products' },
    { name: '研究成果', url: '/products/research' },
  ]} />

  <PageShell>
    <PageHero
      image={technologyImage}
      title="研究成果"
      lead="花農家が自らコードを書き、栽培とテクノロジーの接点を探る。"
      crumb={[
        { name: 'ホーム', url: '/' },
        { name: '商品・研究成果', url: '/products' },
        { name: '研究成果' },
      ]}
    />

    <PageIntro>
      <p>日々の栽培で感じる課題を、テクノロジーで解決する取り組みを続けています。IoTデータ分析、栽培管理システム、自動化の取り組みを公開しています。</p>
      <p>市販のツールでは花卉農家特有のワークフローに合わないことが多く、自らWebアプリケーションを開発し、実際の農作業で検証しています。ここでは、それらの自作アプリのデモと技術的な取り組みを、note記事と合わせてご紹介します。</p>
    </PageIntro>

    <!-- 自作アプリ -->
    <section class="sec inner">
      <h2>自作アプリ</h2>
      <p class="lead">実際の栽培業務で使用しているWebアプリケーション。デモ版でお試しいただけます。</p>

      <div class="demo-note">
        <p>
          デモ版は<b>サンプルデータ</b>で動作しています。
          デモ生成を自動化している都合上、実際のアプリとは表示やデザインが異なる箇所があります。
          一部レイアウト崩れ等が発生する場合がありますのでご了承ください。
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {researchApps.map((app, index) => (
          <AppShowcaseCard app={app} index={index} />
        ))}
      </div>
    </section>

    <!-- 技術的アプローチ -->
    <section class="sec inner">
      <h2>技術的アプローチ</h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center border border-eolica-green/20">
            <svg class="w-6 h-6 text-eolica-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg text-wet-soil mb-2">IoT連携</h3>
          <p class="font-serif text-xs text-warm-gray-500 leading-relaxed">
            Raspberry Pi + センサーで温湿度・日射量を常時計測。データはBigQueryに蓄積し分析に活用。
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center border border-eolica-green/20">
            <svg class="w-6 h-6 text-eolica-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="font-serif text-lg text-wet-soil mb-2">自前開発</h3>
          <p class="font-serif text-xs text-warm-gray-500 leading-relaxed">
            Astro + Preactで軽量なSPAを構築。Firebaseで認証・データ管理を行い、農家自身が運用可能な設計。
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center border border-eolica-green/20">
            <svg class="w-6 h-6 text-eolica-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg text-wet-soil mb-2">AI活用</h3>
          <p class="font-serif text-xs text-warm-gray-500 leading-relaxed">
            Slack上のAIアシスタントが栽培データを分析し、朝ブリーフィングや市況速報を自動配信。
          </p>
        </div>
      </div>
    </section>

    <!-- 関連記事 -->
    <section class="sec inner">
      <h2>関連記事</h2>
      <p class="lead">開発の裏話や技術的な詳細はnoteで連載しています。</p>

      <div class="grid md:grid-cols-2 gap-6">
        <NoteLinkCard
          title={SITE_CONFIG.noteMagazines.agriDX.title}
          titleEn={SITE_CONFIG.noteMagazines.agriDX.titleEn}
          description={SITE_CONFIG.noteMagazines.agriDX.description}
          url={SITE_CONFIG.noteMagazines.agriDX.url}
        />
        <NoteLinkCard
          title={SITE_CONFIG.noteMagazines.farmerLetter.title}
          titleEn={SITE_CONFIG.noteMagazines.farmerLetter.titleEn}
          description={SITE_CONFIG.noteMagazines.farmerLetter.description}
          url={SITE_CONFIG.noteMagazines.farmerLetter.url}
        />
      </div>
    </section>

    <OtherCategories current="research" />
    <ContactBand heading="技術的なお問い合わせ" text="農業DXに関する取り組みや、技術的なご質問がありましたらお気軽にお問い合わせください。" />
  </PageShell>

  <!-- Demo Modal (React Island) -->
  <DemoModal client:idle />
</Layout>

<style>
  .inner { padding-left: 20px; padding-right: 20px; }
  .sec { padding-top: 48px; }
  .sec h2 { font-size: 21px; font-weight: 600; color: #4A3B32; margin: 0 0 10px; line-height: 1.5; }
  .lead { font-size: 14.5px; line-height: 1.85; color: #4A3B32; margin: 0 0 18px; }
  .demo-note { border: 1px solid #E0DDD7; border-radius: 6px; background: #FBFBF9; padding: 14px 16px; margin-bottom: 24px; }
  .demo-note p { font-size: 13px; line-height: 1.85; color: #4A3B32; margin: 0; }
  @media (min-width: 768px) {
    .inner { padding-left: max(48px, calc(50% - 552px)); padding-right: max(48px, calc(50% - 552px)); }
    .sec { padding-top: 56px; }
    .sec h2 { font-size: 24px; }
  }
</style>
