---
/**
 * 花束・テーブルフラワーページ（スマホ第一・商品一覧と同じ作り）
 * 題の写真 → 紹介 → 棚 → 花の時期になったら出る花 → これまでの花 → ご購入の前に → ほかの種類 → お問い合わせ
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import bouquetHeroImage from '../../assets/images/products/bouquet-hero.jpg';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import LaterList from '../../components/products/catalog/LaterList.astro';
import PastStrip from '../../components/products/catalog/PastStrip.astro';
import InfoRows from '../../components/products/catalog/InfoRows.astro';
import InfoRow from '../../components/products/catalog/InfoRow.astro';
import InfoPriceList from '../../components/products/catalog/InfoPriceList.astro';
import InfoCare from '../../components/products/catalog/InfoCare.astro';
import InfoNotice from '../../components/products/catalog/InfoNotice.astro';
import InfoBuy from '../../components/products/catalog/InfoBuy.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
import { byCategory, splitByStatus } from '../../components/products/catalog/split';

// 花束・テーブルフラワーの商品を取得し、棚／あとで／これまでに振り分ける
const bouquetProducts = byCategory(await getCollection('products'), 'bouquet');
const { shelf, later, past } = splitByStatus(bouquetProducts);
const priced = [...shelf, ...later];

// ご注意の情報
const noticeItems = [
  {
    title: '商品特性',
    items: [
      '季節の花を一人で栽培しているため、時期や注文数によってはお受けできない場合があります',
      '自然の花を使用するため、写真とはお色や咲き具合が多少異なる場合があります',
      '季節変動：時期により使用する花の種類が変わります',
    ]
  },
  {
    title: '梱包・配送について',
    items: [
      '保水処理：茎を水で湿らせた状態で梱包',
      '専用梱包：花束・アレンジの形を保ったまま丁寧に梱包',
      '配送方法：佐川急便（通常宅配便）',
      '送料は箱のサイズによって異なります。詳しくは各商品ページをご確認ください',
    ]
  },
  {
    title: '到着後のお願い',
    text: '到着後はすぐに茎を切り戻して水に生けてください。2〜3日に一度の水替えで長くお楽しみいただけます。'
  }
];

const crumb = [
  { name: 'ホーム', url: '/' },
  { name: '商品', url: '/products' },
  { name: '花束・テーブルフラワー' },
];
---

<Layout
  title="花束・テーブルフラワー | Farm Eolica (ファームエオリカ)"
  description="福島の畑で育てた季節の花を、そのまま飾れる形にしてご自宅へお届けします。Farm Eolicaの花束・テーブルフラワー。"
  image="/images/top/hero.jpg"
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
    { name: '花束・テーブルフラワー', url: '/products/bouquet' },
  ]} />

  <PageShell>
    <PageHero
      image={bouquetHeroImage}
      alt="花束・テーブルフラワー"
      title="花束・テーブルフラワー"
      lead="福島の畑で育てた季節の花を、そのまま飾れる形にしてご自宅へ。"
      crumb={crumb}
    />

    <PageIntro>
      <p>福島県浜通り、浪江町の小さな花農家です。市場に出す花と同じものを、その週に咲いた花で組んでお届けします。</p>
      <p>飾ってすぐに楽しめる形にして、花のある暮らしをご自宅まで。</p>
    </PageIntro>

    <ProductShelf
      airy
      items={shelf}
      heading="いま買える花束"
      showPrice={true}
      emptyText="いまは花束の受付を休んでいます。次に咲く花は出荷予報でご覧いただけます。"
    />
    <LaterList items={later} noun="花束" />
    <PastStrip items={past} />

    <InfoRows>
      <InfoRow title="値段" open>
        <p>花束・テーブルフラワーの価格は、<b>商品ごとに異なります</b>。</p>
        <p>季節や花材の入り方によって組み合わせが変わるため、各商品ページに価格を掲載しています。</p>
        <InfoPriceList items={priced} />
        <p class="note">※表示価格はすべて税込です。</p>
      </InfoRow>
      <InfoRow title="送料">
        <p>送料は商品ごとに異なります（80/100サイズ基準）。各商品ページをご覧ください。</p>
        {bouquetProducts.length > 0 && (
          <ul>
            {bouquetProducts.map((p) => (
              <li><a href={`/products/${p.slug}`}>{p.data.name} →</a></li>
            ))}
          </ul>
        )}
      </InfoRow>
      <InfoRow title="届いたら"><InfoCare /></InfoRow>
      <InfoRow title="ご注意"><InfoNotice items={noticeItems} /></InfoRow>
      <InfoRow title="お支払い・ご購入の流れ"><InfoBuy /></InfoRow>
    </InfoRows>

    <OtherCategories current="bouquet" />
    <ContactBand />
  </PageShell>
</Layout>
