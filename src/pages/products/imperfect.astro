---
/**
 * 規格外切り花ページ（スマホ第一・商品一覧と同じ作り）
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import imperfectHeroImage from '../../assets/images/products/imperfect-hero.jpg';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import LaterList from '../../components/products/catalog/LaterList.astro';
import PastStrip from '../../components/products/catalog/PastStrip.astro';
import InfoRows from '../../components/products/catalog/InfoRows.astro';
import InfoRow from '../../components/products/catalog/InfoRow.astro';
import InfoShipping from '../../components/products/catalog/InfoShipping.astro';
import InfoCompare from '../../components/products/catalog/InfoCompare.astro';
import InfoCare from '../../components/products/catalog/InfoCare.astro';
import InfoNotice from '../../components/products/catalog/InfoNotice.astro';
import InfoBuy from '../../components/products/catalog/InfoBuy.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
import { byCategory, splitByStatus } from '../../components/products/catalog/split';

// 規格外品の商品を取得し、棚／あとで／これまでに振り分ける
const imperfectProducts = byCategory(await getCollection('products'), 'imperfect');
const { shelf, later, past } = splitByStatus(imperfectProducts);

// ご注意の情報
const noticeItems = [
  {
    title: '商品特性',
    items: [
      '規格外品のため、市場品のような均一性はありません',
      '発生量に限りがあり、ご注文をお受けできない場合があります',
      '季節変動：時期により取扱品目が変わります',
      '自然の個性：曲がり・色ムラ・サイズ不揃いを含みます',
    ]
  },
  {
    title: '梱包・配送について',
    items: [
      '保水処理：茎を水で湿らせた状態で梱包',
      '専用梱包：フラワースリーブで花束を保護',
      '配送方法：佐川急便（通常宅配便）',
    ]
  },
  {
    title: '到着後のお願い',
    text: '到着後はすぐに茎を切り戻して水に生けてください。2〜3日に一度の水替えで長くお楽しみいただけます。'
  }
];

const compareRows: [string, string, string][] = [
  ['形態', '茎付き（切り花）', '花頭のみ'],
  ['用途', '花瓶に生けて鑑賞', 'クラフト・ドライフラワー'],
  ['価格', '花の種類により異なる', '一律価格'],
];
---

<Layout
  title="規格外切り花 | Farm Eolica (ファームエオリカ)"
  description="市場規格外でも美しさは変わらない。Farm Eolicaの規格外切り花を農家直送でお届けします。"
  image={imperfectHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
    { name: '規格外切り花', url: '/products/imperfect' },
  ]} />

  <PageShell>
    <PageHero
      image={imperfectHeroImage}
      alt="規格外切り花"
      title="規格外切り花"
      lead="咲き誇る花に、規格はいらない。"
      crumb={[
        { name: 'ホーム', url: '/' },
        { name: '商品', url: '/products' },
        { name: '規格外切り花' },
      ]}
    />

    <PageIntro>
      <p>福島県浜通り、浪江町の小さな花農家です。茎の長さが少し足りない、形や色合いが規格とわずかに違う。そんな理由だけで市場に出せない花があります。</p>
      <p>でも、その美しさは市場品と変わりません。季節ごとの規格外切り花を、ご自宅へ直接お届けします。</p>
    </PageIntro>

    <ProductShelf
      airy
      items={shelf}
      heading="いま買える花"
      showPrice={false}
      emptyText="いまは規格外切り花の受付を休んでいます。次に咲く花は出荷予報でご覧いただけます。"
    />
    <LaterList items={later} noun="切り花" showPrice={false} />
    <PastStrip items={past} />

    <InfoRows>
      <InfoRow title="値段" open>
        <p>規格外切り花の価格は、<b>花の種類や時期によって異なります</b>。</p>
        <p>同じ花でも、季節や出荷状況によって規格外となる理由や量が変わるため、都度適正な価格を設定しています。</p>
        <p class="note">※詳しい価格は各商品ページをご確認ください。<br />※表示価格はすべて税込・送料別となります。</p>
      </InfoRow>
      <InfoRow title="送料"><InfoShipping /></InfoRow>
      <InfoRow title="ロスフラワーとの違い">
        <InfoCompare
          cols={['規格外切り花', 'ロスフラワー']}
          rows={compareRows}
          linkHref="/products/loss-flower"
          linkText="ロスフラワーはこちら →"
        />
      </InfoRow>
      <InfoRow title="届いたら"><InfoCare /></InfoRow>
      <InfoRow title="ご注意"><InfoNotice items={noticeItems} /></InfoRow>
      <InfoRow title="お支払い・ご購入の流れ"><InfoBuy /></InfoRow>
    </InfoRows>

    <OtherCategories current="imperfect" />
    <ContactBand />
  </PageShell>
</Layout>
