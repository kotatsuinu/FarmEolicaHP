---
/**
 * 市場出荷品ページ（スマホ第一・商品一覧と同じ作り）
 * 作物ごとの独自品質規格を開示し、信頼獲得を目指す
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import marketHeroImage from '../../assets/images/products/market-hero.jpg';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import PageIntro from '../../components/products/catalog/PageIntro.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import LaterList from '../../components/products/catalog/LaterList.astro';
import PastStrip from '../../components/products/catalog/PastStrip.astro';
import InfoRows from '../../components/products/catalog/InfoRows.astro';
import InfoRow from '../../components/products/catalog/InfoRow.astro';
import OtherCategories from '../../components/products/catalog/OtherCategories.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';
import { byCategory, splitByStatus } from '../../components/products/catalog/split';

// 市場出荷品の商品を取得し、棚／あとで／これまでに振り分ける
const marketProducts = byCategory(await getCollection('products'), 'market');
const { shelf, later, past } = splitByStatus(marketProducts);
---

<Layout
  title="市場出荷品 | Farm Eolica (ファームエオリカ)"
  description="Farm Eolicaが市場向けに出荷している花の品質を、独自規格で正直に開示しています。"
  image={marketHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
    { name: '市場出荷品', url: '/products/market' },
  ]} />

  <PageShell>
    <PageHero
      image={marketHeroImage}
      alt="市場出荷品"
      title="市場出荷品"
      lead="品質を、正直に。独自規格で伝える花のこと。"
      crumb={[
        { name: 'ホーム', url: '/' },
        { name: '商品', url: '/products' },
        { name: '市場出荷品' },
      ]}
    />

    <PageIntro>
      <p>市場に出荷する花には秀・優・良の等級がありますが、同じ「秀」でも作付けごとに品質は変わります。Farm Eolicaでは独自の品質規格を設け、花の品質を写真付きで正直に開示しています。</p>
      <p>期待と現実のギャップが一番もったいない。だから、先に見せます。</p>
    </PageIntro>

    <ProductShelf
      airy
      items={shelf}
      heading="いま市場に出している花"
      showPrice={false}
      chipLabel="市場出荷"
      emptyText="いまは市場出荷の品目がありません。次に咲く花は出荷予報でご覧いただけます。"
    />
    <LaterList items={later} noun="花" showPrice={false} />
    <PastStrip items={past} />

    <InfoRows heading="独自の品質規格について">
      <InfoRow title="3つの考え方" open>
        <ol>
          <li><b>作付けごとに定義</b>：収穫物の分布を見て、その作付けに最適な品質区分を毎回設定します。</li>
          <li><b>写真付きで開示</b>：各等級の特徴を代表写真と具体的な基準で示します。長さではなく花の品質に焦点を当てます。</li>
          <li><b>正直な情報提供</b>：良い点も課題も隠さず伝え、買い手とのミスマッチを防ぎます。</li>
        </ol>
      </InfoRow>
    </InfoRows>

    <OtherCategories current="market" />
    <ContactBand heading="お取引のご相談" text="市場出荷品についてのご相談や、お取引のお問い合わせはお気軽にどうぞ。" />
  </PageShell>
</Layout>
