---
/**
 * 商品一覧ページ（スマホ第一）
 * 上から：題の写真 → いま買える花 → 花の種類から選ぶ → ほかのページ
 *         → これから出る花の帯 → 考え方 → お問い合わせ
 * 設計案：2026-11-13 園主了承。奥行きの動きは末尾の script（写真だけ遅れて動かす）。
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config/site';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';

import productsHeroImage from '../../assets/images/products/products-hero.jpg';
import bouquetImage from '../../assets/images/products/bouquet-hero.jpg';
import categoryImperfectImage from '../../assets/images/products/category-imperfect.jpg';
import categoryLossFlowerImage from '../../assets/images/products/category-loss-flower.jpg';
import dialogueImage from '../../assets/images/top/dialogue.jpg';

// いま買える花（販売中・季節限定）をカテゴリー順＋フォルダ名順に並べる
const categoryOrder = ['bouquet', 'imperfect', 'loss_flower', 'dried_flower', 'market'];
const rank = (c: string) => {
  const i = categoryOrder.indexOf(c);
  return i === -1 ? categoryOrder.length : i;
};
const buyable = (await getCollection('products'))
  .filter((p) => p.data.saleStatus === 'available' || p.data.saleStatus === 'seasonal')
  .sort((a, b) => rank(a.data.category) - rank(b.data.category) || a.slug.localeCompare(b.slug));
const count = buyable.length;

const chipLabel = (s: string) => (s === 'seasonal' ? '季節限定' : '販売中');

const tiles = [
  { title: '花束・テーブルフラワー', note: 'ご自宅に・贈り物に', href: '/products/bouquet', image: bouquetImage },
  { title: '規格外切り花', note: 'たっぷり使いたい方に', href: '/products/imperfect', image: categoryImperfectImage },
  { title: 'ロスフラワー', note: 'クラフトの素材に', href: '/products/loss-flower', image: categoryLossFlowerImage },
];

const others = [
  { title: 'ドライフラワー', note: '花の頭だけ・茎つきの2種類', href: '/products/dry-flower' },
  { title: '市場出荷品', note: 'お花屋さん・市場の方へ（品質の規格）', href: '/products/market' },
  { title: '研究成果', note: '畑で作ったアプリと記録', href: '/products/research' },
];
---

<Layout
  title="商品 | Farm Eolica (ファームエオリカ)"
  description="Farm Eolicaの商品一覧。福島県浪江町の畑で育てた花を、花束・規格外切り花・ロスフラワーなどでお届けします。"
  image={productsHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
  ]} />

  <div class="pl">
    <!-- 題の写真 -->
    <section class="plx hero">
      <Image
        src={productsHeroImage}
        alt=""
        widths={[640, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-txt">
        <h1>商品</h1>
        <p>福島県浪江町の畑で育てた花を、花束や切り花でお届けします。</p>
      </div>
    </section>

    <div class="inner crumb">
      <Breadcrumb items={[
        { name: 'ホーム', url: '/' },
        { name: '商品' },
      ]} />
    </div>

    <!-- いま買える花 -->
    <section class="sec inner">
      <div class="sec-h">
        <h2>いま買える花</h2>
        <small>{count}件</small>
      </div>

      {count > 0 ? (
        <>
          <div class="shelf">
            {buyable.map((p) => (
              <a class="pc" href={`/products/${p.slug}`}>
                <div class="pc-img">
                  {p.data.image ? (
                    <Image src={p.data.image} alt={p.data.name} width={600} height={750} sizes="(min-width: 768px) 25vw, 66vw" loading="lazy" />
                  ) : (
                    <span class="noimg">画像準備中</span>
                  )}
                  <span class="chip">{chipLabel(p.data.saleStatus)}</span>
                </div>
                <h3>{p.data.name}</h3>
                {p.data.flowerType && <span class="sub">{p.data.flowerType}</span>}
                {p.data.price && (
                  <span class="price">¥{p.data.price.toLocaleString()} <small>／ {p.data.unit}</small></span>
                )}
              </a>
            ))}
            <a class="pc-next" href="/cultivation">
              <b>これから出る花</b>
              <span>畑で育っている花と、出荷の見込み</span>
              <i>出荷予報を見る →</i>
            </a>
          </div>
          <p class="swipe">← 横にめくれます</p>
        </>
      ) : (
        <div class="empty plx">
          <Image src={dialogueImage} alt="" width={1200} sizes="(min-width: 768px) 1100px, 100vw" loading="lazy" />
          <div class="empty-txt">
            <b>いま販売中の花はありません</b>
            <p>畑で育っている花と、次に出る時期の見込みは、出荷予報のページで見られます。</p>
            <div class="btns">
              <a class="btn" href="/cultivation">これから出る花を見る →</a>
              <a class="btn ol" href={SITE_CONFIG.sns.line} target="_blank" rel="noopener">公式LINEで聞いてみる</a>
            </div>
          </div>
        </div>
      )}
    </section>

    <!-- 花の種類から選ぶ -->
    <section class="sec inner">
      <div class="sec-h"><h2>花の種類から選ぶ</h2></div>
      <div class="cats">
        {tiles.map((t) => (
          <a class="tile plx" href={t.href}>
            <Image src={t.image} alt="" width={900} sizes="(min-width: 768px) 600px, 100vw" loading="lazy" />
            <div class="tile-txt">
              <small>{t.note}</small>
              <b>{t.title}</b>
              <i>→</i>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ほかのページ -->
    <section class="sec inner">
      <div class="sec-h"><h2>ほかのページ</h2></div>
      <div class="others">
        {others.map((o) => (
          <a class="ot" href={o.href}>
            <div><b>{o.title}</b><span>{o.note}</span></div>
            <i>→</i>
          </a>
        ))}
      </div>
    </section>

    <!-- これから出る花の帯（販売中があるときだけ） -->
    {count > 0 && (
      <section class="band plx">
        <Image src={dialogueImage} alt="" width={1600} sizes="100vw" loading="lazy" />
        <div class="band-txt">
          <small>出荷予報</small>
          <b>これから出る花</b>
          <p>ハウスでいま育っている花と、出荷の見込みを公開しています。</p>
          <div class="btns"><a class="btn" href="/cultivation">出荷予報を見る →</a></div>
        </div>
      </section>
    )}

    <!-- 考え方 -->
    <section class="philo inner">
      <h2>もったいないを、価値に変える</h2>
      <p>市場の規格に満たない花も、美しさは変わりません。規格の外に出た花に、別の楽しみ方を用意しています。</p>
      <a href="/about">Farm Eolicaについて →</a>
    </section>

    <!-- お問い合わせ -->
    <section class="contact">
      <div class="contact-in">
        <div>
          <h2>お問い合わせ・ご注文</h2>
          <p>花の種類や届く日のご相談も、お気軽にどうぞ。</p>
        </div>
        <div class="cbtns">
          <a class="cbtn main" href={SITE_CONFIG.sns.line} target="_blank" rel="noopener">公式LINEで問い合わせる</a>
          <a class="cbtn" href={SITE_CONFIG.sns.instagram} target="_blank" rel="noopener">Instagram</a>
          <a class="cbtn" href="/contact">お問い合わせフォーム</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .pl { font-family: theme('fontFamily.serif'); color: #33291F; line-height: 1.85; overflow-x: clip; }
  .pl a { color: inherit; text-decoration: none; }
  .inner { padding-left: 20px; padding-right: 20px; }

  /* 奥行きの動き：枠より大きい写真を、スクロールに合わせて script が動かす */
  .plx { position: relative; overflow: hidden; }
  .plx > :global(img) {
    position: absolute; left: 0; width: 100%; top: -15%; height: 130%;
    object-fit: cover; will-change: transform;
  }
  .hero::after, .tile::after, .band::after, .empty::after { content: ''; position: absolute; inset: 0; z-index: 1; }

  .hero { height: 300px; color: #fff; }
  .hero::after { background: linear-gradient(to top, rgba(22,26,24,.72), rgba(22,26,24,.05) 70%); }
  .hero-txt { position: absolute; left: 20px; right: 20px; bottom: 22px; z-index: 2; display: grid; gap: 6px; }
  .hero h1 { font-size: 30px; font-weight: 600; letter-spacing: .04em; color: #fff; line-height: 1.45; margin: 0; }
  .hero p { font-size: 14px; line-height: 1.75; opacity: .92; margin: 0; }

  .crumb { padding-top: 12px; }

  .sec { padding-top: 28px; padding-bottom: 8px; }
  .sec-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .sec-h h2 { font-size: 21px; font-weight: 600; color: #4A3B32; margin: 0; line-height: 1.5; }
  .sec-h small { font-family: theme('fontFamily.mono'); font-size: 12px; color: #B87333; }

  /* 棚 */
  .shelf {
    display: grid; grid-auto-flow: column; grid-auto-columns: 66%; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    margin: 0 -20px; padding: 0 20px 6px; scroll-padding: 20px; scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar { display: none; }
  .pc { scroll-snap-align: start; display: grid; gap: 4px; align-content: start; }
  .pc-img { position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: #E0DDD7; }
  .pc-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .noimg { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; color: #7D7B77; }
  .chip { position: absolute; top: 8px; left: 8px; font-size: 11px; padding: 2px 8px; border-radius: 3px; background: #005243; color: #fff; line-height: 1.7; }
  .pc h3 { font-size: 16px; font-weight: 600; margin: 6px 0 0; color: #33291F; line-height: 1.5; }
  .sub { font-size: 12px; color: #7D7B77; }
  .price { font-family: theme('fontFamily.mono'); font-size: 14px; color: #4A3B32; }
  .price small { color: #7D7B77; font-size: 12px; }
  .pc-next {
    scroll-snap-align: start; border-radius: 6px; background: #005243; color: #fff !important;
    aspect-ratio: 4 / 5; padding: 18px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;
  }
  .pc-next b { font-size: 18px; font-weight: 600; }
  .pc-next span { font-size: 12.5px; opacity: .85; line-height: 1.6; }
  .pc-next i { font-style: normal; font-family: theme('fontFamily.mono'); font-size: 13px; margin-top: 6px; }
  .swipe { font-size: 11px; color: #7D7B77; margin: 6px 0 0; }

  /* 0件のとき */
  .empty { border-radius: 8px; height: 280px; color: #fff; }
  .empty::after { background: linear-gradient(to top, rgba(0,40,33,.82), rgba(0,40,33,.25)); }
  .empty-txt { position: absolute; inset: auto 18px 18px 18px; z-index: 2; display: grid; gap: 8px; }
  .empty-txt b { font-size: 19px; font-weight: 600; line-height: 1.5; }
  .empty-txt p { font-size: 12.5px; line-height: 1.7; opacity: .92; margin: 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .btn { font-size: 13px; padding: 9px 14px; border-radius: 4px; background: #F2F2F0; color: #005243 !important; font-weight: 600; line-height: 1.6; }
  .btn.ol { background: transparent; color: #fff !important; border: 1px solid rgba(255,255,255,.7); font-weight: 400; }

  /* 花の種類 */
  .cats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .tile { border-radius: 6px; color: #fff; aspect-ratio: 1 / 1.08; display: block; }
  .tile:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
  .tile::after { background: linear-gradient(to top, rgba(20,22,20,.7), rgba(20,22,20,0) 62%); }
  .tile-txt { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 2; display: grid; }
  .tile-txt small { font-size: 11px; opacity: .88; }
  .tile-txt b { font-size: 18px; font-weight: 600; line-height: 1.5; }
  .tile:first-child .tile-txt b { font-size: 22px; }
  .tile-txt i { font-style: normal; font-family: theme('fontFamily.mono'); font-size: 12px; opacity: .9; }

  /* ほかのページ */
  .others { display: grid; }
  .ot { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; padding: 14px 2px; border-top: 1px solid #E0DDD7; }
  .ot:last-child { border-bottom: 1px solid #E0DDD7; }
  .ot b { font-size: 16px; font-weight: 600; display: block; line-height: 1.5; }
  .ot span { font-size: 12px; color: #7D7B77; }
  .ot i { font-style: normal; font-family: theme('fontFamily.mono'); color: #B87333; }

  /* これから出る花の帯 */
  .band { height: 330px; color: #fff; margin-top: 36px; }
  .band::after { background: linear-gradient(to right, rgba(0,52,43,.78), rgba(0,52,43,.35)); }
  .band-txt { position: absolute; left: 20px; right: 20px; top: 50%; transform: translateY(-50%); z-index: 2; display: grid; gap: 10px; max-width: 440px; }
  .band-txt small { font-size: 11.5px; opacity: .85; }
  .band-txt b { font-size: 24px; font-weight: 600; line-height: 1.45; }
  .band-txt p { font-size: 13px; line-height: 1.75; opacity: .92; margin: 0; }

  /* 考え方 */
  .philo { padding-top: 40px; padding-bottom: 36px; display: grid; gap: 10px; }
  .philo h2 { font-size: 21px; font-weight: 600; color: #005243; margin: 0; line-height: 1.5; }
  .philo p { font-size: 14.5px; color: #4A3B32; margin: 0; }
  .philo a { font-size: 13px; color: #B87333; }

  /* お問い合わせ */
  .contact { background: #005243; color: #fff; padding: 36px 20px; }
  .contact-in { display: grid; gap: 12px; }
  .contact h2 { font-size: 20px; font-weight: 600; margin: 0; line-height: 1.5; }
  .contact p { font-size: 13px; opacity: .88; margin: 0; }
  .cbtns { display: grid; gap: 8px; margin-top: 4px; }
  .cbtn { font-size: 14px; padding: 12px 14px; border-radius: 4px; border: 1px solid rgba(255,255,255,.6); text-align: center; color: #fff !important; }
  .cbtn.main { background: #F2F2F0; color: #005243 !important; border-color: #F2F2F0; font-weight: 700; }

  @media (min-width: 768px) {
    .inner { padding-left: max(48px, calc(50% - 552px)); padding-right: max(48px, calc(50% - 552px)); }
    .hero { height: 400px; }
    .hero-txt { left: max(48px, calc(50% - 552px)); right: auto; bottom: 40px; max-width: 560px; }
    .hero h1 { font-size: 40px; }
    .hero p { font-size: 15px; }
    .sec { padding-top: 48px; }
    .sec-h h2 { font-size: 24px; }
    .shelf { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; margin: 0; padding: 0; gap: 20px; }
    .swipe { display: none; }
    .empty { height: 300px; }
    .empty-txt { inset: auto 40px 36px 40px; max-width: 520px; }
    .cats { grid-template-columns: 1.45fr 1fr; grid-template-rows: 240px 240px; gap: 16px; }
    .tile, .tile:first-child { aspect-ratio: auto; }
    .tile:first-child { grid-column: auto; grid-row: 1 / 3; }
    .others { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .ot, .ot:last-child { border: 1px solid #E0DDD7; border-radius: 6px; padding: 16px 18px; background: #FBFBF9; }
    .band { height: 420px; margin-top: 56px; }
    .band-txt { left: max(48px, calc(50% - 552px)); }
    .philo { padding-top: 56px; padding-bottom: 56px; }
    .philo p { max-width: 40em; }
    .contact { padding: 48px max(48px, calc(50% - 552px)); }
    .contact-in { grid-template-columns: 1fr auto; align-items: center; }
    .cbtns { grid-auto-flow: column; margin: 0; }
    .cbtn { padding: 12px 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plx > :global(img) { transform: none !important; }
  }
</style>

<script>
  // 奥行きの動き：枠の中心が画面中心からどれだけ離れているかで、写真を -11%〜+11% 動かす
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const frames = Array.from(document.querySelectorAll<HTMLElement>('.pl .plx'));
    const visible = new Set<HTMLElement>();
    const update = () => {
      const vh = window.innerHeight;
      visible.forEach((el) => {
        const img = el.querySelector<HTMLElement>(':scope > img');
        if (!img) return;
        const r = el.getBoundingClientRect();
        let p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
        p = Math.max(-1, Math.min(1, p));
        img.style.transform = `translate3d(0, ${(-p * 11).toFixed(2)}%, 0)`;
      });
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) visible.add(el);
        else visible.delete(el);
      });
      onScroll();
    });
    frames.forEach((el) => io.observe(el));
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
