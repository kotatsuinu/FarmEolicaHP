---
/**
 * 商品一覧ページ（スマホ第一）
 * 上から：題の写真 → いま買える花 → 花の種類から選ぶ → ほかのページ
 *         → これから出る花の帯 → 考え方 → お問い合わせ
 * 設計案：2026-11-13 園主了承。題・棚・お問い合わせ帯と奥行きの動きは catalog/ の部品。
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config/site';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import PageShell from '../../components/products/catalog/PageShell.astro';
import PageHero from '../../components/products/catalog/PageHero.astro';
import ProductShelf from '../../components/products/catalog/ProductShelf.astro';
import ContactBand from '../../components/products/catalog/ContactBand.astro';

import productsHeroImage from '../../assets/images/products/products-hero.jpg';
import bouquetImage from '../../assets/images/products/bouquet-hero.jpg';
import categoryImperfectImage from '../../assets/images/products/category-imperfect.jpg';
import categoryLossFlowerImage from '../../assets/images/products/category-loss-flower.jpg';
import dialogueImage from '../../assets/images/top/dialogue.jpg';

// いま買える花（販売中・季節限定）をカテゴリー順＋フォルダ名順に並べる
const categoryOrder = ['bouquet', 'imperfect', 'loss_flower', 'dried_flower', 'market'];
const rank = (c: string) => {
  const i = categoryOrder.indexOf(c);
  return i === -1 ? categoryOrder.length : i;
};
const buyable = (await getCollection('products'))
  .filter((p) => p.data.saleStatus === 'available' || p.data.saleStatus === 'seasonal')
  .sort((a, b) => rank(a.data.category) - rank(b.data.category) || a.slug.localeCompare(b.slug));
const count = buyable.length;

const tiles = [
  { title: '花束・テーブルフラワー', note: 'ご自宅に・贈り物に', href: '/products/bouquet', image: bouquetImage },
  { title: '規格外切り花', note: 'たっぷり使いたい方に', href: '/products/imperfect', image: categoryImperfectImage },
  { title: 'ロスフラワー', note: 'クラフトの素材に', href: '/products/loss-flower', image: categoryLossFlowerImage },
];

const others = [
  { title: 'ドライフラワー', note: '花の頭だけ・茎つきの2種類', href: '/products/dry-flower' },
  { title: '市場出荷品', note: 'お花屋さん・市場の方へ（品質の規格）', href: '/products/market' },
  { title: '研究成果', note: '畑で作ったアプリと記録', href: '/products/research' },
];
---

<Layout
  title="商品 | Farm Eolica (ファームエオリカ)"
  description="Farm Eolicaの商品一覧。福島県浪江町の畑で育てた花を、花束・規格外切り花・ロスフラワーなどでお届けします。"
  image={productsHeroImage.src}
  ogType="website"
>
  <BreadcrumbSchema items={[
    { name: 'ホーム', url: '/' },
    { name: '商品', url: '/products' },
  ]} />

  <PageShell>
    <PageHero
      image={productsHeroImage}
      title="商品"
      lead="福島県浪江町の畑で育てた花を、花束や切り花でお届けします。"
      crumb={[{ name: 'ホーム', url: '/' }, { name: '商品' }]}
    />

    <!-- いま買える花 -->
    <ProductShelf items={buyable} heading="いま買える花">
      <Fragment slot="empty">
        <div class="empty plx">
          <Image src={dialogueImage} alt="" width={1200} sizes="(min-width: 768px) 1100px, 100vw" loading="lazy" />
          <div class="empty-txt">
            <b>いま販売中の花はありません</b>
            <p>畑で育っている花と、次に出る時期の見込みは、出荷予報のページで見られます。</p>
            <div class="btns">
              <a class="btn" href="/cultivation">これから出る花を見る →</a>
              <a class="btn ol" href={SITE_CONFIG.sns.line} target="_blank" rel="noopener">公式LINEで聞いてみる</a>
            </div>
          </div>
        </div>
      </Fragment>
    </ProductShelf>

    <!-- 花の種類から選ぶ -->
    <section class="sec inner">
      <div class="sec-h"><h2>花の種類から選ぶ</h2></div>
      <div class="cats">
        {tiles.map((t) => (
          <a class="tile plx" href={t.href}>
            <Image src={t.image} alt="" width={900} sizes="(min-width: 768px) 600px, 100vw" loading="lazy" />
            <div class="tile-txt">
              <small>{t.note}</small>
              <b>{t.title}</b>
              <i>→</i>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ほかのページ -->
    <section class="sec inner">
      <div class="sec-h"><h2>ほかのページ</h2></div>
      <div class="others">
        {others.map((o) => (
          <a class="ot" href={o.href}>
            <div><b>{o.title}</b><span>{o.note}</span></div>
            <i>→</i>
          </a>
        ))}
      </div>
    </section>

    <!-- これから出る花の帯（販売中があるときだけ） -->
    {count > 0 && (
      <section class="band plx">
        <Image src={dialogueImage} alt="" width={1600} sizes="100vw" loading="lazy" />
        <div class="band-txt">
          <small>出荷予報</small>
          <b>これから出る花</b>
          <p>ハウスでいま育っている花と、出荷の見込みを公開しています。</p>
          <div class="btns"><a class="btn" href="/cultivation">出荷予報を見る →</a></div>
        </div>
      </section>
    )}

    <!-- 考え方 -->
    <section class="philo inner">
      <h2>もったいないを、価値に変える</h2>
      <p>市場の規格に満たない花も、美しさは変わりません。規格の外に出た花に、別の楽しみ方を用意しています。</p>
      <a href="/about">Farm Eolicaについて →</a>
    </section>

    <ContactBand />
  </PageShell>
</Layout>

<style>
  .inner { padding-left: 20px; padding-right: 20px; }

  /* 写真の上に重ねる暗幕（奥行きの枠 .plx は PageShell が持つ） */
  .tile::after, .band::after, .empty::after { content: ''; position: absolute; inset: 0; z-index: 1; }

  .sec { padding-top: 28px; padding-bottom: 8px; }
  .sec-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .sec-h h2 { font-size: 21px; font-weight: 600; color: #4A3B32; margin: 0; line-height: 1.5; }

  /* 0件のとき */
  .empty { border-radius: 8px; height: 280px; color: #fff; }
  .empty::after { background: linear-gradient(to top, rgba(0,40,33,.82), rgba(0,40,33,.25)); }
  .empty-txt { position: absolute; inset: auto 18px 18px 18px; z-index: 2; display: grid; gap: 8px; }
  .empty-txt b { font-size: 19px; font-weight: 600; line-height: 1.5; }
  .empty-txt p { font-size: 12.5px; line-height: 1.7; opacity: .92; margin: 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .btn { font-size: 13px; padding: 9px 14px; border-radius: 4px; background: #F2F2F0; color: #005243 !important; font-weight: 600; line-height: 1.6; }
  .btn.ol { background: transparent; color: #fff !important; border: 1px solid rgba(255,255,255,.7); font-weight: 400; }

  /* 花の種類 */
  .cats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .tile { border-radius: 6px; color: #fff; aspect-ratio: 1 / 1.08; display: block; }
  .tile:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
  .tile::after { background: linear-gradient(to top, rgba(20,22,20,.7), rgba(20,22,20,0) 62%); }
  .tile-txt { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 2; display: grid; }
  .tile-txt small { font-size: 11px; opacity: .88; }
  .tile-txt b { font-size: 18px; font-weight: 600; line-height: 1.5; }
  .tile:first-child .tile-txt b { font-size: 22px; }
  .tile-txt i { font-style: normal; font-family: theme('fontFamily.mono'); font-size: 12px; opacity: .9; }

  /* ほかのページ */
  .others { display: grid; }
  .ot { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; padding: 14px 2px; border-top: 1px solid #E0DDD7; }
  .ot:last-child { border-bottom: 1px solid #E0DDD7; }
  .ot b { font-size: 16px; font-weight: 600; display: block; line-height: 1.5; }
  .ot span { font-size: 12px; color: #7D7B77; }
  .ot i { font-style: normal; font-family: theme('fontFamily.mono'); color: #B87333; }

  /* これから出る花の帯 */
  .band { height: 330px; color: #fff; margin-top: 36px; }
  .band::after { background: linear-gradient(to right, rgba(0,52,43,.78), rgba(0,52,43,.35)); }
  .band-txt { position: absolute; left: 20px; right: 20px; top: 50%; transform: translateY(-50%); z-index: 2; display: grid; gap: 10px; max-width: 440px; }
  .band-txt small { font-size: 11.5px; opacity: .85; }
  .band-txt b { font-size: 24px; font-weight: 600; line-height: 1.45; }
  .band-txt p { font-size: 13px; line-height: 1.75; opacity: .92; margin: 0; }

  /* 考え方 */
  .philo { padding-top: 40px; padding-bottom: 36px; display: grid; gap: 10px; }
  .philo h2 { font-size: 21px; font-weight: 600; color: #005243; margin: 0; line-height: 1.5; }
  .philo p { font-size: 14.5px; color: #4A3B32; margin: 0; }
  .philo a { font-size: 13px; color: #B87333; }

  @media (min-width: 768px) {
    .inner { padding-left: max(48px, calc(50% - 552px)); padding-right: max(48px, calc(50% - 552px)); }
    .sec { padding-top: 48px; }
    .sec-h h2 { font-size: 24px; }
    .empty { height: 300px; }
    .empty-txt { inset: auto 40px 36px 40px; max-width: 520px; }
    .cats { grid-template-columns: 1.45fr 1fr; grid-template-rows: 240px 240px; gap: 16px; }
    .tile, .tile:first-child { aspect-ratio: auto; }
    .tile:first-child { grid-column: auto; grid-row: 1 / 3; }
    .others { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .ot, .ot:last-child { border: 1px solid #E0DDD7; border-radius: 6px; padding: 16px 18px; background: #FBFBF9; }
    .band { height: 420px; margin-top: 56px; }
    .band-txt { left: max(48px, calc(50% - 552px)); }
    .philo { padding-top: 56px; padding-bottom: 56px; }
    .philo p { max-width: 40em; }
  }
</style>
