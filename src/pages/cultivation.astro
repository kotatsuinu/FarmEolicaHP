---
import Layout from '../layouts/Layout.astro';
import ShipmentForecast from '../components/forecast/ShipmentForecast.astro';
import { buildForecastView, type PhotoMap } from '../lib/shipmentForecast/view';
import { loadForecastFile, resolveForecastSettings } from '../lib/shipmentForecast/load';
import photos from '../data/shipment_forecast_photos.json';

// 公開の目印に関係なく毎回読む（壊れたファイルはここでビルドを落とす）。ファイルが無いときだけ null
const { published, dataFile } = resolveForecastSettings(process.env);
const forecast = loadForecastFile(dataFile);
const description = published
  ? 'Farm Eolicaの出荷予報です。品目ごとの出荷の見込みをご案内します。'
  : 'Farm Eolicaの出荷予報ページは現在準備中です。';
const view = buildForecastView({ forecast, photos: photos as PhotoMap });
---

<Layout title="Shipment Forecast | Farm Eolica (ファームエオリカ)" description={description}>
  {forecast && <meta slot="head" name="forecast-generated-at" content={forecast.generated_at} />}
  {published ? (
    <ShipmentForecast view={view} />
  ) : (
    <Fragment>
  <div class="min-h-[80vh] flex flex-col items-center justify-center px-6 text-center">
    <div data-animate>
      <p class="font-mono text-xs tracking-widest text-warm-gray-500 mb-6">
        SHIPMENT FORECAST
      </p>
      <h1 class="font-serif text-4xl md:text-5xl text-eolica-green mb-6 tracking-wide">
        Coming Soon
      </h1>
      <p class="font-mono text-sm text-wet-soil tracking-widest mb-4">
        現在準備中です
      </p>
      <p class="text-warm-gray-600 text-base max-w-md mx-auto leading-relaxed mb-12 font-serif">
        出荷予報ページは現在制作中です。<br />
        生育状況やお取引のご相談は、<a href="/contact" class="text-old-copper hover:underline">お問い合わせページ</a>よりご連絡ください。
      </p>
      <div class="flex gap-6 justify-center">
        <a
          href="/"
          class="text-xs font-mono border-b border-old-copper pb-1 hover:border-eolica-green hover:text-eolica-green transition-colors duration-300"
        >
          Return to Top
        </a>
        <a
          href="/contact"
          class="text-xs font-mono border-b border-old-copper pb-1 hover:border-eolica-green hover:text-eolica-green transition-colors duration-300"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>
</Fragment>
  )}
</Layout>
