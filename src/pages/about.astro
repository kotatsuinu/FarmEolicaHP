---
/**
 * 農園についてページ（商品ページと同じ型：スマホ第一・影なし・英語の小見出しなし）
 */
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config/site';
import NoteLinkCard from '../components/NoteLinkCard.astro';
import PersonSchema from '../components/seo/PersonSchema.astro';
import PageShell from '../components/products/catalog/PageShell.astro';
import ContactBand from '../components/products/catalog/ContactBand.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutProfile from '../components/about/AboutProfile.astro';

import heroImage from '../assets/images/about/hero.jpg';
import originImage from '../assets/images/about/origin.jpg';
import identityImage from '../assets/images/about/identity.jpg';
import technologyImage from '../assets/images/about/technology.jpg';
import locationImage from '../assets/images/about/location.jpg';
import philosophyImage from '../assets/images/about/philosophy.jpg';

const profileRows: [string, string][] = [
  ['屋号', 'Farm Eolica（ファーム・エオリカ）'],
  ['園主', '関口 卓磨（Sekiguchi Takuma）'],
  ['所在地', '福島県双葉郡浪江町立野地区'],
  ['事業内容', 'トルコギキョウ、スプレーマム、ストック等の切り花生産・販売'],
  ['開業', '2024年'],
];
---

<Layout title="農園について | Farm Eolica（ファームエオリカ）" description="風を読み、土を耕し、未来を咲かせる。Farm Eolicaの思想と背景。" image={heroImage.src}>

<PersonSchema />

<PageShell>
  <AboutHero
    image={heroImage}
    alt="Farm Eolica"
    titleLines={['風を読み、土を耕し、', '未来を咲かせる。']}
    lead="浪江町で花を育てる、Farm Eolica のこと。"
    crumb={[
      { name: 'ホーム', url: '/' },
      { name: '農園について' },
    ]}
  />

  <AboutStory image={originImage} alt="Origin - 風とともに生きる農園" label="名前の由来" heading={['「風」とともに生きる農園']}>
    <p>「Farm Eolica(ファーム・エオリカ)」という名前は、ギリシャ神話に登場する風の神「アイオロス(Aeolus)」に由来しています。</p>
    <p>私たちの農園がある福島県浪江町は、海と山に囲まれ、常に心地よい風が吹き抜ける場所です。時に厳しく、時に優しく吹くこの土地の「風」を受け入れ、味方にし、自然と共生しながら美しい花を育てたい。そんな願いを込めて名付けました。</p>
  </AboutStory>

  <AboutStory image={identityImage} alt="Identity - 言葉を紡ぐ手から、命を育む手へ" label="園主のこと" heading={['言葉を紡ぐ手から、', '命を育む手へ']} reverse>
    <p>園主は元々、タウン情報誌の編集者として働いていました。地域の魅力や人の想いを「言葉」で伝える仕事から、自らの手で価値を生み出す「農業」の世界へ。</p>
    <p>異業種から参入したからこそ、既存の枠にとらわれない視点を大切にしています。一輪の花が持つ美しさだけでなく、それがお客様の手に渡るまでのストーリーも大切に紡いでいきます。</p>
    <div class="card">
      <NoteLinkCard
        url={SITE_CONFIG.noteMagazines.newFarmerJourney.url}
        title="新規就農のリアルを綴ったnote"
        variant="subtle"
      />
    </div>
  </AboutStory>

  <AboutStory image={technologyImage} alt="Technology - データが支え、感性が仕上げる" label="育て方" heading={['データが支え、', '感性が仕上げる']}>
    <p>Farm Eolicaでは、温度・湿度・日射量などの環境データをリアルタイムで収集・分析する「スマート農業」を、独自開発(※)で実践しています。</p>
    <p>植物の声なき声(データ)にも耳を傾け、最適な環境を整えること。そうして生まれた余裕を、一輪一輪の花と向き合う「人の目」と「人の手」に注ぐこと。</p>
    <p>昔ながらの職人仕事に、テクノロジーのエッセンスを加えて。この両輪で、高品質な花づくりを目指しています。</p>
    <p class="note">※農研機構「通い農業支援システム」をベースに独自改良を加えて運用</p>
  </AboutStory>

  <AboutStory image={locationImage} alt="Location - 浪江の地から、新しい色を" label="場所" heading={['浪江の地から、', '新しい色を']} reverse>
    <p>震災からの復興が進む浪江町。一度は更地になったこの場所だからこそ、描ける未来があります。</p>
    <p>彩りのなかった土地に、ハウスを建て、苗を植え、花が咲く。その景色そのものが、復興の歩みです。私はこの地で、先人たちの想いや取り組みを大切にしつつ、新しい価値と風景を創り出していきたいと思っています。</p>
  </AboutStory>

  <AboutStory image={philosophyImage} alt="Philosophy - より良いものを、届け続ける農園であること" label="これから" heading={['より良いものを、', '届け続ける農園であること']}>
    <p>風は、いつも同じようには吹かない。</p>
    <p>追い風の年もあれば、向かい風に押し戻される年もある。それでも倒れず、風を受けて立ち続けること。</p>
    <p>去年より少しだけ良い花を育て、少しだけ良い届け方を重ねて、また次の季節へ。</p>
    <p><strong>より良いものを、届け続ける農園であること。</strong><br />その先に、まだ見ぬ景色がきっとある。</p>
  </AboutStory>

  <AboutProfile rows={profileRows} />

  <ContactBand
    heading="ご注文・ご相談はこちらから"
    text="より良いものを届け続けるために。Farm Eolica の物語は、これからも続きます。"
  />
</PageShell>

</Layout>
